{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for the Freewrite app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "fs:scope-document-recursive",
    "shell:default",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
