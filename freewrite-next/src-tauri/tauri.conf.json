{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freewrite",
  "version": "1.0.0",
  "identifier": "app.humansongs.freewrite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Freewrite",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Distraction-free writing app",
    "longDescription": "A distraction-free macOS application for freewriting sessions. Set a timer, start writing, and let your thoughts flow.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    }
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": ["$DOCUMENT/**", "$HOME/Documents/**"],
        "deny": []
      }
    },
    "shell": {
      "open": true
    }
  }
}
